# Independent clone runtime. Do not copy values from the source application.
PORT=4319
HOST=127.0.0.1
SESSION_SECRET=replace-with-a-long-random-value

# Optional paid text AI. It is deliberately not the default Wayne path.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# LiveAvatar free FULL sandbox. Never commit real values.
PATHBRIDGE_ZERO_PAYMENT=true
PATHBRIDGE_AVATAR_PROVIDER=liveavatar
PATHBRIDGE_AVATAR_SANDBOX=true
LIVEAVATAR_API_KEY=
# Dedicated INFINITE-X business agent. Do not reuse PathBridge's interview agent ID.
LIVEAVATAR_VOICE_AGENT_ID=
# Optional read-only reference used only to prevent accidental reuse.
LIVEAVATAR_SANDBOX_AGENT_ID=

# Email. "preview" is safe and stores messages in the local outbox.
EMAIL_MODE=preview
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
SMTP_HELO=localhost

# Local OpenEdge/PAS ports used by scripts/start-services.ps1.
OPENEDGE_DB_PORT=4335
OPENEDGE_PAS_PORT=4326
