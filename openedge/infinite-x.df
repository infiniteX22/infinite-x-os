ADD TABLE "IXUser"
  AREA "Schema Area"
  LABEL "INFINITE-X user"
ADD FIELD "ActorId" OF "IXUser" AS character FORMAT "x(40)" INITIAL "" LABEL "User ID"
ADD FIELD "DisplayName" OF "IXUser" AS character FORMAT "x(100)" INITIAL ""
ADD FIELD "RoleCode" OF "IXUser" AS character FORMAT "x(40)" INITIAL ""
ADD FIELD "Active" OF "IXUser" AS logical INITIAL yes
ADD INDEX "IXUserPK" ON "IXUser"
  AREA "Schema Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "ActorId" ASCENDING

ADD TABLE "IXProject" AREA "Schema Area"
ADD FIELD "ProjectId" OF "IXProject" AS character FORMAT "x(40)" INITIAL ""
ADD FIELD "ModeCode" OF "IXProject" AS character FORMAT "x(4)" INITIAL "REAL"
ADD FIELD "Name" OF "IXProject" AS character FORMAT "x(120)" INITIAL ""
ADD FIELD "ClientName" OF "IXProject" AS character FORMAT "x(120)" INITIAL ""
ADD FIELD "OwnerId" OF "IXProject" AS character FORMAT "x(40)" INITIAL ""
ADD FIELD "ProgressPct" OF "IXProject" AS integer INITIAL 0
ADD FIELD "StatusCode" OF "IXProject" AS character FORMAT "x(30)" INITIAL "Active"
ADD FIELD "DueDate" OF "IXProject" AS date
ADD FIELD "BudgetCents" OF "IXProject" AS int64 INITIAL 0
ADD FIELD "CostCents" OF "IXProject" AS int64 INITIAL 0
ADD FIELD "Blocker" OF "IXProject" AS character FORMAT "x(300)" INITIAL ""
ADD FIELD "UpdatedAt" OF "IXProject" AS datetime-tz
ADD INDEX "IXProjectPK" ON "IXProject"
  AREA "Schema Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "ProjectId" ASCENDING
ADD INDEX "IXProjectMode" ON "IXProject"
  AREA "Schema Area"
  INDEX-FIELD "ModeCode" ASCENDING
  INDEX-FIELD "StatusCode" ASCENDING

ADD TABLE "IXTask" AREA "Schema Area"
